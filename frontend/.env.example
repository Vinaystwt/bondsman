# Base origin of the Bondsman backend REST API.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001

# Server-only. Forwarded as `Authorization: Bearer <token>` by the Next API
# proxy routes to the operator-gated backend endpoints (challenge, resolve,
# demo arm/watchdog, wallet-resolve, demo ready/proofs). Must match the
# backend's OPERATOR_API_TOKEN. Never exposed to the browser.
OPERATOR_API_TOKEN=
